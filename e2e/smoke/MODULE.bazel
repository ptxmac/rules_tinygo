go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_google_uuid")

bazel_dep(name = "rules_tinygo", version = "0.0.0")
local_path_override(
    module_name = "rules_tinygo",
    path = "../..",
)

